<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.yknotify.daemon</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/yknotify</string>
        <string>-fifo</string>
        <string>/var/run/yknotify.fifo</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardErrorPath</key>
    <string>/var/log/yknotify-daemon.log</string>
</dict>
</plist>
